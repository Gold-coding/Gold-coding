#include <iostream>
#include <vector>
#include <memory>

using namespace std;

struct Ball {
    float x, y;
    float vx, vy;
    float mass;
    int index;

    Ball() : x(0), y(0), vx(0), vy(0), mass(1.0f), index(-1) {}
};

template<typename T>
class MemoryPool {
    struct Block {
        unique_ptr<T[]> data;
        int capacity;
        int used;

        Block(int cap) : data(make_unique<T[]>(cap)), capacity(cap), used(0) {}
    };

    vector<Block> blocks;
    vector<T*> freeList;
    int blockSize;

    void addBlock() {
        blocks.emplace_back(blockSize);
        Block& b = blocks.back();
        for (int i = 0; i < b.capacity; ++i)
            freeList.push_back(&b.data[i]);
        blockSize *= 2;
    }

public:
    MemoryPool(int initial = 4) : blockSize(initial) {
        addBlock();
    }

    T* allocate() {
        if (freeList.empty())
            addBlock();

        T* obj = freeList.back();
        freeList.pop_back();
        return obj;
    }

    void deallocate(T* obj) {
        freeList.push_back(obj);
    }
};

int main() {
    MemoryPool<Ball> pool(4);

    Ball* b1 = pool.allocate();
    Ball* b2 = pool.allocate();
    Ball* b3 = pool.allocate();
    Ball* b4 = pool.allocate();
    Ball* b5 = pool.allocate();

    pool.deallocate(b2);
    pool.deallocate(b4);

    Ball* b6 = pool.allocate();

    return 0;
}
