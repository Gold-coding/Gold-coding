#include <iostream>
#include <cmath>
using namespace std;

double sin_maclaurin(double x, int n) {
    double term = x;
    double sum = x;
    for (int i = 1; i < n; i++) {
        term *= -1 * x * x / ((2 * i) * (2 * i + 1));
        sum += term;
    }
    return sum;
}

int main() {
    double x;
    int n;
    cin >> x >> n;
    cout << sin_maclaurin(x, n) << endl;
    return 0;
}
